# dm/host unit tests in one command: make -C dm/host/tests GAME=<base game title ID> run (takes seconds; build output goes to build/ and is not committed)
B = build
PYTHON ?= python3
# game profile header (dm.h needs game_profile.h, generated by the host Makefile into ../gen/<profile>/)
# tests that use the game profile need GAME=<base game title ID> (there is no default game); GINC only expands when used, so tests without the profile build as before
GINC = $(if $(strip $(GAME)),-I../gen/$(GAME) -I../../games/$(GAME),$(error GAME is not set: make GAME=<base game title ID>: $(shell python3 ../../games/game.py list | awk -F'\t' '{printf "%s (%s)  ", $$1, $$3}')))
GAME_H = ../gen/$(GAME)/game_profile.h
run: $(B)/t_heap_size $(B)/t_touch $(B)/t_gesture $(B)/t_oe $(B)/t_fs $(B)/t_fs_commit_list $(B)/t_thread_leak $(B)/t_fs_case $(B)/t_audio $(B)/t_audio_spsc $(B)/t_swkbd $(B)/t_altstack $(B)/t_condvar $(B)/t_condvar_old $(B)/t_pctl $(B)/t_time $(B)/t_shared_font $(B)/t_vorbis $(B)/t_vorbis_divides $(B)/t_hid $(B)/t_haptics $(B)/t_haptics_apple $(B)/t_controls $(B)/t_joycon_protocol $(B)/t_joycon_rumble $(B)/t_joycon_output
	$(B)/t_heap_size
	$(B)/t_touch
	$(B)/t_gesture
	$(B)/t_oe 2>/dev/null
	$(B)/t_oe_handoff
	$(B)/t_fs 2>/dev/null
	TMPDIR="$(abspath $(B))" $(B)/t_fs_commit_list
	$(B)/t_thread_leak
	TMPDIR="$(abspath $(B))" $(B)/t_fs_case 2>/dev/null
	$(B)/t_audio
	$(B)/t_audio_spsc
	$(B)/t_fpslock
	$(B)/t_audren_work
	$(B)/t_swkbd
	$(B)/t_altstack
	$(B)/t_condvar
	$(B)/t_condvar_old
	$(B)/t_preempt
	$(B)/t_preempt --all-peers
	$(B)/t_pctl
	$(B)/t_time
	$(B)/t_shared_font
	$(B)/t_system_event
	$(B)/t_vorbis
	$(B)/t_vorbis_divides
	$(B)/t_movie_vpx
	$(B)/t_hid
	$(B)/t_haptics
	$(B)/t_haptics_apple
	$(B)/t_controls
	$(B)/t_network_mac
	$(B)/t_hle_wait
	$(B)/t_net --no-broadcast
	$(B)/t_joycon_protocol
	$(B)/t_joycon_rumble
	$(B)/t_joycon_output
	$(B)/t_nro
	$(B)/t_symbols
run: $(B)/t_nro
run: $(B)/t_symbols
run: $(B)/t_net
$(B)/t_net: t_net.c ../hle_net.c ../hle_offline.c ../hle_net_backend.c ../net_socket.h ../net_discovery.h ../net_discovery_queue.inc ../discovery_protocol.h ../hle.h ../hle_bigstack.c ../entry.S $(GAME_H) | $(B)
	clang -O1 -g -Wall -Wextra -Werror -Wno-unused-function $(GINC) -o $@ t_net.c ../hle_net.c ../hle_offline.c ../hle_net_backend.c ../hle_bigstack.c ../entry.S
$(B)/t_net_asan: t_net.c ../hle_net.c ../hle_offline.c ../hle_net_backend.c ../net_socket.h ../net_discovery.h ../net_discovery_queue.inc ../discovery_protocol.h ../hle.h ../hle_bigstack.c ../entry.S $(GAME_H) | $(B)
	clang -O1 -g -Wall -Wextra -Werror -Wno-unused-function -fsanitize=address,undefined -mllvm -asan-globals=0 -fno-omit-frame-pointer $(GINC) -o $@ t_net.c ../hle_net.c ../hle_offline.c ../hle_net_backend.c ../hle_bigstack.c ../entry.S
.PHONY: net net-broadcast net-sanitize
FRIENDS_HISTORY_SOURCES = t_friends_history.c ../hle_friends_history.c
