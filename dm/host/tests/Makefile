# dm/host unit tests in one command: make -C dm/host/tests GAME=<base game title ID> run (takes seconds; build output goes to build/ and is not committed)
B = build
.DEFAULT_GOAL := run
.PHONY: display display-sanitize
$(B)/t_display: t_display.c ../hle_display.c ../display_mode.h ../dm.h memory_profile/game_profile.h | $(B)
	$(CLANG) -O1 -g -Wall -Wextra -Werror -Imemory_profile -o $@ t_display.c ../hle_display.c
$(B)/t_display_asan: t_display.c ../hle_display.c ../display_mode.h ../dm.h memory_profile/game_profile.h | $(B)
	$(CLANG) -O1 -g -Wall -Wextra -Werror -Imemory_profile -fsanitize=address,undefined -fno-omit-frame-pointer -o $@ t_display.c ../hle_display.c
$(B)/t_display_mac: t_display_mac.m ../display_mac.inc ../display_mode.h | $(B)
	$(CLANG) -O1 -g -Wall -Wextra -Werror -Wno-unused-function -fobjc-arc -o $@ t_display_mac.m -framework Cocoa -framework QuartzCore
display: $(B)/t_display $(B)/t_display_mac
	$(B)/t_display
	$(B)/t_display_mac
display-sanitize: $(B)/t_display_asan
	$(B)/t_display_asan
PYTHON ?= python3
ifndef DM_OPENSSL_ROOT
DM_OPENSSL_ROOT := $(shell python3 ../../tools/apple_crypto.py macos)
endif
OPENSSL_TOOL ?= $(firstword $(wildcard /opt/homebrew/opt/openssl@4/bin/openssl /usr/local/opt/openssl@4/bin/openssl))
PRIVATE_PKI_FLAGS = -DDM_OPENSSL_X509 "-I$(DM_OPENSSL_ROOT)/include"
PRIVATE_PKI_LIB = "$(DM_OPENSSL_ROOT)/lib/libcrypto.a"
# SAN: extra compiler flags for a sanitizer or coverage build (make asan, make tsan-threads and make coverage below set it, with B = a build folder of their own); empty otherwise
SAN ?=
CLANG = clang $(SAN)
# stderr that the plain run hides is kept in sanitizer builds: the sanitizers report there
QUIET = $(if $(findstring -fsanitize,$(SAN)),,2>/dev/null)
.DEFAULT_GOAL := run
# game profile header (dm.h needs game_profile.h, generated by the host Makefile into ../gen/<profile>/)
# tests that use the game profile need GAME=<base game title ID> (there is no default game); GINC only expands when used, so tests without the profile build as before
GINC = $(if $(strip $(GAME)),-I../gen/$(GAME) -I../../games/$(GAME),$(error GAME is not set: make GAME=<base game title ID>: $(shell python3 ../../games/game.py list | awk -F'\t' '{printf "%s (%s)  ", $$1, $$3}')))
$(B)/t_fs $(B)/t_fs_case $(B)/t_fs_commit_list $(B)/t_fs_commit_list_tsan: ../romfs_image.h
$(B)/t_fs $(B)/t_fs_directory $(B)/t_fs_case $(B)/t_fs_commit_list $(B)/t_fs_commit_list_tsan $(B)/t_save_sync $(B)/t_bcat_fs: bcat_absent.h
GAME_H = ../gen/$(GAME)/game_profile.h
