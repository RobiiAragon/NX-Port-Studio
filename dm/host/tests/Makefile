ACCOUNT_SOURCES = t_nextendo_account.m ../hle_account.c ../hle_nextendo_apple.m ../hle_bigstack.c ../entry.S
ACCOUNT_DEPS = $(ACCOUNT_SOURCES) ../nextendo_account.h ../net_socket.h ../hle.h $(GAME_H)
$(B)/t_nextendo_account: $(ACCOUNT_DEPS) | $(B)
	clang $(SSL_FLAGS) -o $@ $(ACCOUNT_SOURCES) -framework Foundation -framework Security
$(B)/t_nextendo_account_asan: $(ACCOUNT_DEPS) | $(B)
	clang $(SSL_FLAGS) -fsanitize=address,undefined -mllvm -asan-globals=0 -fno-omit-frame-pointer -o $@ $(ACCOUNT_SOURCES) -framework Foundation -framework Security
.PHONY: nextendo-account nextendo-account-sanitize
nextendo-account: $(B)/t_nextendo_account
	$(B)/t_nextendo_account
nextendo-account-sanitize: $(B)/t_nextendo_account_asan
	$(B)/t_nextendo_account_asan

ROUTE_SOURCES = t_nextendo_routes.c ../hle_nextendo_routes.c ../hle_net_backend.c ../hle_ssl_apple.m
ROUTE_DEPS = $(ROUTE_SOURCES) ../nextendo_routes.h ../net_socket.h ../ssl_backend.h test_nextendo_routes.py test_ssl_transport.py
$(B)/t_nextendo_routes: $(ROUTE_DEPS) | $(B)
	clang -O1 -g -fobjc-arc -mmacosx-version-min=14.0 -Wall -Wextra -Werror -o $@ $(ROUTE_SOURCES) -framework Foundation -framework Security
$(B)/t_nextendo_routes_asan: $(ROUTE_DEPS) | $(B)
	clang -O1 -g -fobjc-arc -mmacosx-version-min=14.0 -Wall -Wextra -Werror -fsanitize=address,undefined -fno-omit-frame-pointer -o $@ $(ROUTE_SOURCES) -framework Foundation -framework Security
.PHONY: nextendo-routes nextendo-routes-sanitize
nextendo-routes: $(B)/t_nextendo_routes
	$(PYTHON) test_nextendo_routes.py $(B)/t_nextendo_routes
nextendo-routes-sanitize: $(B)/t_nextendo_routes_asan
	$(PYTHON) test_nextendo_routes.py $(B)/t_nextendo_routes_asan
